export direnv_root=$(pwd)

# direnv's stdlib resolves its layout dir as ${direnv_layout_dir:-$PWD/.direnv},
# and the fragments below run with PWD at .envrcs/ (source_env pushd's into
# the fragment's directory), so anything using the layout dir would put it in
# .envrcs/.direnv while .venv sits at the root — and `rm -rf .direnv` from
# here would leave the stale contents behind.
#
# What this covers is a fragment that does not pushd — `layout python` added
# to .envrc.user, say.
# Only a default: `:-` so a direnvrc that sets direnv_layout_dir itself keeps
# its value — direnv sources the direnvrc before this file, and a plain
# assignment here would silently override the user's own choice.
direnv_layout_dir=${direnv_layout_dir:-$direnv_root/.direnv}

# Then resolve it once, here, and pin the function to the result. A direnvrc
# that redefines direnv_layout_dir as a *function* of $PWD (the direnv wiki's
# ~/.cache/direnv/layouts/ recipe) ignores the variable above, so a fragment
# that does not pushd would get a second layout dir keyed on .envrcs/ — one
# nothing knows to clean up, holding the nix GC roots `use flake`/`use nix`
# leave behind. The direnvrc still decides where layouts go; it is asked once.
direnv_layout_dir=$(direnv_layout_dir)
direnv_layout_dir() { echo "$direnv_layout_dir"; }

# Auto-create the untracked local files from their tracked templates, so a
# fresh clone needs nothing but `direnv allow`. Existing files are never
# overwritten. NOTE: deleting one of these does not disable it — it is
# recreated on the next reload. To durably disable a fragment in one
# checkout, empty it (`> .envrcs/.envrc.user`); an empty file satisfies the
# check below and is a no-op when sourced.
#
# A missing template is skipped, not an error: a repo drops a layer by not
# tracking its template, and this file stays identical whichever layers it
# keeps. Any other install failure still fails (and aborts under strict_env).
_from_template() { # <dest> <mode>
    [ -f "$1" ] || [ ! -f "$1.template" ] || install -m "$2" "$1.template" "$1"
}
_from_template .gitignore 644
_from_template .envrcs/.envrc.secrets 600
_from_template .envrcs/.envrc.user 600

source_env_if_exists .envrcs/.envrc.secrets
source_env_if_exists .envrcs/.envrc.user
